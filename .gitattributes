# Auto detect text files and perform LF normalization
* text=auto

# The Unity source generator is a small, directly consumed UPM analyzer. The
# embedding RelicLight repository tracks *.dll with LFS, but the standalone
# UnityEvalTool Git tree must contain the real DLL so Git URL installs and
# GitHub Actions checkouts work without an external LFS object.
Packages/com.yuzetoolkit.yuzeevaltool/Analyzers/UnityEvalTool.SourceGenerator.dll -lfs -filter -diff -merge -text
