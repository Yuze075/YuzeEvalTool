/* Shared Yuze Eval Tool workbench skin used by EditorWindow and Runtime Console. */
.uet-workbench {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
    background-color: rgb(21, 21, 23);
    color: rgb(207, 211, 214);
}

.uet-workbench-header {
    min-width: 0;
    min-height: 62px;
    flex-direction: row;
    align-items: center;
    padding: 10px 14px;
    flex-shrink: 0;
    background-color: rgb(35, 35, 36);
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.06);
}
.uet-workbench-heading { flex-grow: 1; min-width: 0; }
.uet-workbench-title { min-height: 24px; color: rgb(249, 250, 251); font-size: 16px; -unity-font-style: bold; -unity-text-align: middle-left; }
.uet-workbench-subtitle { min-width: 0; min-height: 18px; color: rgb(129, 133, 140); font-size: 12px; -unity-text-align: middle-left; white-space: nowrap; text-overflow: ellipsis; }

.uet-workbench-tabs {
    min-height: 42px;
    flex-direction: row;
    align-items: flex-end;
    padding: 6px 12px 0 12px;
    flex-shrink: 0;
    background-color: rgb(27, 27, 28);
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.06);
}

.uet-workbench-owned-button {
    min-width: 0;
    min-height: 28px;
    margin: 0 6px 0 0;
    padding: 3px 10px;
    flex-shrink: 0;
    background-image: none;
    background-color: transparent;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    color: rgb(249, 250, 251);
    font-size: 13px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    text-overflow: ellipsis;
}
.uet-workbench-owned-button:hover { background-color: rgba(255, 255, 255, 0.08); }
.uet-workbench-owned-button:active,
.uet-workbench-owned-button:focus { background-color: rgba(255, 255, 255, 0.14); border-color: rgb(96, 165, 250); }
.uet-workbench-owned-button:disabled { opacity: 0.4; background-image: none; }

.uet-workbench-tab {
    width: 112px;
    height: 32px;
    border-width: 0 0 2px 0;
    border-radius: 0;
    border-bottom-color: transparent;
    color: rgb(173, 178, 184);
}
.uet-workbench-tab-active { color: rgb(96, 165, 250); border-bottom-color: rgb(96, 165, 250); -unity-font-style: bold; }

.uet-workbench-badge {
    min-width: 0;
    min-height: 24px;
    margin-right: 6px;
    padding: 2px 9px;
    flex-shrink: 1;
    background-color: rgb(53, 54, 56);
    border-radius: 12px;
    color: rgb(249, 250, 251);
    font-size: 12px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    text-overflow: ellipsis;
}
.uet-workbench-badge-success { background-color: rgba(34, 197, 94, 0.30); color: rgb(249, 250, 251); }
.uet-workbench-badge-warning { background-color: rgba(221, 134, 41, 0.30); color: rgb(249, 250, 251); }
.uet-workbench-badge-muted { background-color: rgb(53, 54, 56); color: rgb(173, 178, 184); }
.uet-workbench-switch { width: 104px; min-width: 84px; margin-right: 0; }
.uet-workbench-switch-on { background-color: rgba(96, 165, 250, 0.20); border-color: rgb(96, 165, 250); color: rgb(249, 250, 251); }

.uet-workbench-scroll { flex-grow: 1; min-width: 0; min-height: 0; padding: 12px 14px 16px 14px; background-color: rgb(21, 21, 23); }
.uet-workbench-scroll > .unity-scroll-view__content-viewport { background-image: none; background-color: transparent; }
.uet-workbench-scroll .unity-scroll-view__content-container { min-width: 0; }
.uet-workbench-scroll .unity-scroll-view__vertical-scroller { width: 8px; background-image: none; background-color: transparent; border-width: 0; }
.uet-workbench-scroll .unity-scroller__low-button,
.uet-workbench-scroll .unity-scroller__high-button { display: none; background-image: none; }
.uet-workbench-scroll .unity-scroller__slider,
.uet-workbench-scroll .unity-base-slider { margin: 0; background-image: none; background-color: transparent; border-width: 0; }
.uet-workbench-scroll .unity-base-slider__tracker { background-image: none; background-color: transparent; border-width: 0; }
.uet-workbench-scroll .unity-base-slider__dragger { width: 8px; background-image: none; background-color: rgb(60, 60, 61); border-width: 0; border-radius: 4px; }
.uet-workbench-scroll .unity-base-slider__dragger:hover { background-color: rgb(84, 85, 87); }

.uet-workbench-notice {
    min-width: 0;
    margin-bottom: 10px;
    padding: 9px 11px;
    background-color: rgba(96, 165, 250, 0.10);
    border-left-width: 3px;
    border-left-color: rgb(96, 165, 250);
    border-radius: 8px;
}
.uet-workbench-notice-title { min-height: 22px; color: rgb(249, 250, 251); font-size: 14px; -unity-font-style: bold; -unity-text-align: middle-left; }
.uet-workbench-notice-body,
.uet-workbench-muted { min-width: 0; min-height: 18px; color: rgb(173, 178, 184); font-size: 12px; white-space: normal; }

.uet-workbench-card {
    min-width: 0;
    margin-bottom: 10px;
    padding: 12px;
    background-color: rgb(35, 35, 36);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
    border-radius: 12px;
}
.uet-workbench-card-title { min-height: 24px; color: rgb(249, 250, 251); font-size: 16px; -unity-font-style: bold; -unity-text-align: middle-left; }
.uet-workbench-field { min-width: 0; min-height: 28px; flex-direction: row; align-items: flex-start; margin-top: 3px; }
.uet-workbench-field-key { width: 150px; min-width: 110px; min-height: 22px; margin-right: 10px; flex-shrink: 1; color: rgb(173, 178, 184); font-size: 14px; white-space: nowrap; text-overflow: ellipsis; }
.uet-workbench-field-value { flex-grow: 1; min-width: 0; min-height: 22px; color: rgb(207, 211, 214); font-size: 14px; white-space: normal; }
.uet-workbench-value-success { color: rgb(34, 197, 94); }
.uet-workbench-value-error { color: rgb(242, 90, 90); }

.uet-workbench-toolbar { min-width: 0; min-height: 40px; flex-direction: row; align-items: center; margin-top: 8px; }
.uet-workbench-button { height: 32px; }
.uet-workbench-search { position: relative; flex-grow: 1; flex-shrink: 1; min-width: 120px; min-height: 32px; margin: 0 8px 0 0; padding: 0; }
.uet-workbench-search > .unity-base-field__label { display: none; }
.uet-workbench-search .unity-base-text-field__input {
    min-width: 0;
    min-height: 32px;
    padding: 4px 8px;
    background-image: none;
    background-color: rgb(35, 35, 36);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    color: rgb(249, 250, 251);
    font-size: 14px;
    --unity-cursor-color: rgb(249, 250, 251);
    --unity-selection-color: rgba(96, 165, 250, 0.34);
}
.uet-workbench-search .unity-base-text-field__input:hover { background-color: rgb(44, 44, 46); border-color: rgba(255, 255, 255, 0.16); }
.uet-workbench-search .unity-base-text-field__input:focus { border-color: rgb(96, 165, 250); }
.uet-workbench-placeholder { position: absolute; left: 9px; top: 0; bottom: 0; min-height: 18px; color: rgb(129, 133, 140); font-size: 12px; -unity-text-align: middle-left; }

.uet-workbench-section-title { min-height: 24px; margin: 4px 0 7px 0; color: rgb(96, 165, 250); font-size: 14px; -unity-font-style: bold; -unity-text-align: middle-left; }
.uet-workbench-tool-header { min-width: 0; min-height: 32px; flex-direction: row; align-items: center; }
.uet-workbench-tool-expand { flex-grow: 1; flex-shrink: 1; justify-content: flex-start; border-width: 0; -unity-text-align: middle-left; }
.uet-workbench-disclosure { width: 9px; min-width: 9px; height: 9px; min-height: 9px; margin-right: 9px; flex-shrink: 0; border-right-width: 2px; border-bottom-width: 2px; border-right-color: rgb(173, 178, 184); border-bottom-color: rgb(173, 178, 184); rotate: -45deg; }
.uet-workbench-tool-expand-open .uet-workbench-disclosure { rotate: 45deg; }
.uet-workbench-pill { min-height: 20px; margin-left: 5px; padding: 1px 7px; flex-shrink: 0; background-color: rgb(53, 54, 56); border-radius: 10px; color: rgb(207, 211, 214); font-size: 12px; -unity-text-align: middle-center; }
.uet-workbench-tool-state { width: 88px; min-width: 72px; margin-left: 6px; margin-right: 0; }
.uet-workbench-tool-description { min-width: 0; min-height: 18px; margin: 5px 5px 0 5px; color: rgb(173, 178, 184); font-size: 12px; white-space: normal; }
.uet-workbench-tool-detail { min-width: 0; margin-top: 9px; padding-top: 8px; border-top-width: 1px; border-top-color: rgba(255, 255, 255, 0.06); }
.uet-workbench-detail-title { min-height: 22px; margin: 9px 0 5px 0; color: rgb(96, 165, 250); font-size: 14px; -unity-font-style: bold; }
.uet-workbench-function { min-width: 0; margin-bottom: 7px; padding: 7px 8px; background-color: rgb(27, 27, 28); border-radius: 8px; }
.uet-workbench-function-signature { min-width: 0; min-height: 22px; color: rgb(249, 250, 251); font-size: 14px; -unity-font-style: bold; white-space: normal; }
